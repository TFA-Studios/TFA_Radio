# --- Database ---------------------------------------------------------
# Postgres connection string (Vercel Postgres / Neon / any Postgres works).
# If unset, lib/db.js and lib/library.js fall back to an in-memory store —
# handy for local dev and for `next build`, but data is lost on restart and
# is NOT shared across serverless function instances in production.
POSTGRES_URL=

# --- AI script generation (lib/scriptgen.js) ---------------------------
# Tier 1: Anthropic/Claude API (paid, best quality). If set, this is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Tier 2: Google Gemini API (free tier, used only if ANTHROPIC_API_KEY is
# unset). Recommended free option — a real hosted API, nothing to run
# yourself. Get a key at https://aistudio.google.com/apikey (double-check
# current free-tier terms there, since they do change over time).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Tier 3: local Ollama model (used only if neither of the above is set).
# Only reachable from a deployed Vercel app if OLLAMA_HOST points at a real,
# always-on Ollama server you host and expose yourself — "localhost" here
# means the serverless function's own container, not your machine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Tier 4 (always available, no config needed): deterministic template
# fallback — used automatically if none of the above is configured or
# if the configured provider call fails for any reason.

# --- Confirmation email (lib/email.js) ---------------------------------
# If set, confirmation emails are sent via Resend. If unset, the email is
# instead stored in the `sent_emails` DB table (or in-memory store) so a
# producer can still inspect what would have been sent.
RESEND_API_KEY=
SENDER_EMAIL=planning@tfa.studio

# --- Team notifications (lib/email.js) ----------------------------------
# Optional. Comma-separated list of inboxes pinged the moment a client
# submits a brief. Put planning@tfa.studio here (plus anyone else who should
# see it) — this is what makes planning receive the SAME overview the client
# gets (full fields + script), not just a short ping, so it can be checked
# and planned into the agenda straight from the email. Uses the same Resend
# setup as the client confirmation email above (falls back to a sent_emails
# DB row if RESEND_API_KEY isn't set). Everything runs inside the app itself
# — no Slack or other outside integration involved.
TEAM_NOTIFY_EMAILS=

# --- Engineer assignment emails (lib/email.js) --------------------------
# Optional, one per studio engineer. When a producer assigns a brief to
# Marco or Karim on the dashboard's Team tab (components/DashboardClient.js's
# ASSIGNEE_OPTIONS), that person gets an email with the brief's overview so
# they know to start working — set either, neither, or both; assigning to
# someone whose var isn't set just silently skips the email.
ENGINEER_EMAIL_MARCO=
ENGINEER_EMAIL_KARIM=

# --- Audio storage for the library (app/dashboard/library/actions.js) --
# Without this configured, uploading a track/voice file in the dashboard
# library still creates the entry, but silently has no playable audio —
# nothing errors, it just has an empty audioUrl. On Vercel, connect a Blob
# store from the project's Storage tab and this is populated automatically
# (BLOB_STORE_ID + an auto-rotated OIDC token) — nothing to paste here.
# BLOB_READ_WRITE_TOKEN is only needed for uploading from outside Vercel
# (e.g. a local dev machine or a CI job).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- Clerk auth (producer dashboard only) -------------------------------
# The client-facing brief flow (/, /brief/*, /api/briefs*) is always public.
# Only /dashboard and /dashboard/* require a signed-in producer.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
